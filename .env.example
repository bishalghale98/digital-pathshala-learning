# ── Database ────────────────────────────────────────────────────────────────
# Single MongoDB URI shared by Mongoose (app data) and Better Auth (users).
MONGODB=

# ── Better Auth ─────────────────────────────────────────────────────────────
# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of this app.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (Better Auth social provider) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Khalti payment gateway (server-side only) ───────────────────────────────
KHALTI_SECRET_KEY=
# Public site URL used to build Khalti return_url / website_url.
NEXT_APP_URL=http://localhost:3000
